---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles, fmt } from '../../lib/articles';
import { TOPICS } from '../../config';

const all = await getArticles();
const featured = all.find((a) => a.data.featured) ?? all[0];
const rest = all.filter((a) => a !== featured);
const topics = [...new Set(all.map((a) => a.data.topic))];
const ft = featured ? TOPICS[featured.data.topic] : null;
---
<Base title="Articles" description="Practical writing on the operational problems growing SaaS companies run into, and what to do about them.">
<main><div class="wrap">
  <div class="pg">
    <h1>Articles</h1>
    <p class="lead">Practical writing on the operational problems growing SaaS companies run into, and what to do about them.</p>
    {all.length > 1 && (
      <div class="chips" role="group" aria-label="Filter by topic">
        <button type="button" class="chip" data-k="all" aria-pressed="true">All</button>
        {topics.map((t) => <button type="button" class="chip" data-k={t} aria-pressed="false">{TOPICS[t].label}</button>)}
      </div>
    )}
  </div>
  {all.length === 0 && <p class="lead">The first articles are on the way.</p>}
  {featured && ft && (
    <a class="feat" href={`/articles/${featured.id}/`} data-cat={featured.data.topic}>
      <div class="tx">
        <span class="lab"><span class={ft.num ? 'hx' : 'hx g'}>{ft.num}</span>{ft.label}</span>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <span class="meta">{fmt(featured.data.date)} · {featured.data.readTime}</span>
      </div>
      <div class="pn" aria-hidden="true"><b>{ft.num || '+'}</b><span>{ft.label}</span></div>
    </a>
  )}
  {rest.length > 0 && <div class="grid">{rest.map((a) => <ArticleCard entry={a} />)}</div>}
  <div class="band"><div class="cta">
    <h2>Want us to look at your own bottlenecks?</h2>
    <p class="lead">Book a free 30-minute call. You leave with three specific fixes, whether or not we work together.</p>
    <a class="btn" href="/contact/" data-open>Book a free call</a>
  </div></div>
</div></main>
</Base>
