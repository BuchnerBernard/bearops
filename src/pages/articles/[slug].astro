---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { render } from 'astro:content';
import { getArticles, fmt } from '../../lib/articles';
import { TOPICS } from '../../config';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, others: all.filter((a) => a.id !== entry.id).slice(0, 2) },
  }));
}

const { entry, others } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const t = TOPICS[entry.data.topic];
---
<Base title={entry.data.title} description={entry.data.description}>
<div id="prog" aria-hidden="true"></div>
<main><div class="wrap"><div class="artwrap">
  <aside class="toc" aria-label="In this article">
    <b>In this article</b>
    {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
  </aside>
  <article class="art">
    <div class="crumb"><a href="/articles/">Articles</a> / {t.label}</div>
    <span class="lab"><span class={t.num ? 'hx' : 'hx g'}>{t.num}</span>{t.label}</span>
    <h1>{entry.data.title}</h1>
    <p class="dek">{entry.data.description}</p>
    <div class="by"><span>Bear Ops</span><span>{fmt(entry.data.date)}</span><span>{entry.data.readTime}</span></div>
    <Content />
    <div class="inl">
      <h3>Want a second pair of eyes on your own business?</h3>
      <p>Book a free 30-minute call. We look at how work moves through your business and give you three specific fixes.</p>
      <a class="btn" href="/contact/" data-open>Book a free call</a>
    </div>
    <div class="author">
      <svg width="44" height="44" viewBox="-44 -44 88 88" aria-hidden="true">
        <polygon transform="translate(-19.5,-22.5)" points="24,0 12,20.8 -12,20.8 -24,0 -12,-20.8 12,-20.8" style="fill:var(--accent)" />
        <polygon transform="translate(-19.5,22.5)" points="24,0 12,20.8 -12,20.8 -24,0 -12,-20.8 12,-20.8" style="fill:var(--ink)" />
        <polygon transform="translate(19.5,0)" points="24,0 12,20.8 -12,20.8 -24,0 -12,-20.8 12,-20.8" style="fill:var(--amber)" />
      </svg>
      <p>Written by Bear Ops. We help growing SaaS companies find the bottlenecks in their business and fix them.</p>
    </div>
    {others.length > 0 && (
      <div class="rel"><h2>Keep reading</h2>
        <div class="grid" style="grid-template-columns:1fr 1fr">{others.map((a) => <ArticleCard entry={a} />)}</div>
      </div>
    )}
  </article>
</div></div></main>
</Base>
